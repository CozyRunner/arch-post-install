* {
    background:     rgba(25, 23, 36, 0.85);
    background-alt: rgba(38, 35, 58, 0.85);
    selected:       #ebbcba;
    foreground:     #e0def4;
    foreground-dim: #908caa;
    accent:         #ebbcba;
    border:         rgba(235, 188, 186, 0.4);

    bg:      @background;
    bg-alt:  @background-alt;
    fg:      @foreground;
    fg-dim:  @foreground-dim;
    sel:     @selected;
    bg-sel:  @background-alt;
}
