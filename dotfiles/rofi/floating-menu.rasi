/**
 * Floating Quick Menu — Rofi Theme
 * Glassmorphic, centered floating panel with icon-style items
 * Author: Sachin
 */

@import "~/.config/rofi/colors.rasi"

* {
    background-color: transparent;
    text-color:       @foreground;
    border-color:     @border;
    spacing:          0;
    padding:          0;
    margin:           0;
}

configuration {
    show-icons:       false;
    hover-select:     true;
    me-select-entry:  "";
    me-accept-entry:  "MousePrimary";
    kb-row-up:        "Up,Control+k,Shift+Tab,Control+p";
    kb-row-down:      "Down,Control+j,Control+n";
    kb-accept-entry:  "Control+m,Return,KP_Enter";
    fixed-num-lines:  true;
}

window {
    transparency:     "real";
    width:            440px;
    border:           1px;
    border-radius:    20px;
    border-color:     @border;
    padding:          0;
    background-color: @background;
    location:         center;
    anchor:           center;
    x-offset:         0;
    y-offset:         0;
}

mainbox {
    padding:          20px;
    spacing:          12px;
    background-color: transparent;
    children:         [ "inputbar", "message", "listview" ];
}

inputbar {
    enabled:          true;
    padding:          10px 14px;
    border-radius:    12px;
    background-color: @background-alt;
    text-color:       @foreground;
    children:         [ "prompt", "entry" ];
    spacing:          10px;
}

prompt {
    font:             "JetBrainsMono Nerd Font Bold 13";
    text-color:       @accent;
    vertical-align:   0.5;
}

entry {
    font:             "JetBrainsMono Nerd Font 12";
    text-color:       @foreground;
    placeholder:      "Type to filter…";
    placeholder-color: @foreground-dim;
    vertical-align:   0.5;
    cursor:           text;
}

message {
    padding:          6px 14px;
    border-radius:    10px;
    background-color: transparent;
}

textbox {
    markup:           false;
    background-color: transparent;
    text-color:       @foreground-dim;
    font:             "JetBrainsMono Nerd Font 11";
    horizontal-align: 0.0;
}

listview {
    columns:          1;
    lines:            9;
    spacing:          6px;
    padding:          0;
    fixed-height:     false;
    fixed-columns:    true;
    background-color: transparent;
    border:           0;
    scrollbar:        false;
    cycle:            true;
    dynamic:          true;
}

element {
    orientation:      horizontal;
    padding:          12px 16px;
    spacing:          12px;
    border-radius:    12px;
    background-color: @background-alt;
    cursor:           pointer;
}

element normal.normal {
    background-color: @background-alt;
    text-color:       @foreground;
}

element alternate.normal {
    background-color: @background-alt;
    text-color:       @foreground;
}

element selected.normal {
    background-color: @selected;
    text-color:       @background;
}

element-icon {
    size:             0px;
}

element-text {
    markup:           false;
    background-color: transparent;
    text-color:       inherit;
    font:             "JetBrainsMono Nerd Font 13";
    vertical-align:   0.5;
    horizontal-align: 0.0;
}
