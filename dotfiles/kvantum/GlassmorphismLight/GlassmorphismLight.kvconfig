[%KvantumStyle]
author=Lumina Light (Glassmorphism)
comment=White frost glassmorphism theme for Qt apps on Hyprland

[GeneralColors]
window.color=#f8fafc
window.color.alpha=195
base.color=#ffffff
base.color.alpha=190
alt.base.color=#f1f5f9
alt.base.color.alpha=185
text.color=#1e1b4b
text.color.alpha=255
disabled.text.color=#9ca3af
disabled.text.color.alpha=200
highlight.color=#6366f1
highlight.color.alpha=255
highlighted.text.color=#ffffff
active.highlight.color=#6366f1
active.highlight.color.alpha=255
inactive.highlight.color=#6366f1
inactive.highlight.color.alpha=120
tooltip.base.color=#f8fafc
tooltip.base.color.alpha=220
tooltip.text.color=#1e1b4b
button.color=#f1f5f9
button.color.alpha=200
label.color=#1e1b4b

[GeneralDesign]
frame.Rounding=12
header.Rounding=10
button.Rounding=8
menu.Rounding=12
tooltip.Rounding=10
progress.Rounding=6
check.Rounding=5
combobox.Rounding=8
entry.Rounding=8

frame.size=1
frame.color=#000000
frame.color.alpha=18

opaque.apps=gvim,krunner

menu.shadow.size=8
menu.shadow.depth=2
tooltip.shadow.size=5
tooltip.shadow.depth=1

[StyleOptions]
translucent.windows=true
composite.menus=true
blurring.policy=blurring.onlycomponents
blurring.contrast=0.95
blurring.intensity=18
blurring.noise=0.008

[MenuSpec]
bg.color=#f8fafc
bg.color.alpha=205
separator.color=#000000
separator.color.alpha=12
item.hover.bg.color=#6366f1
item.hover.bg.color.alpha=25
item.text.color=#1e1b4b
item.disabled.text.color=#9ca3af

[ToolbarSpec]
bg.color=#f8fafc
bg.color.alpha=170

[TabSpec]
tab.text.color=#1e1b4b
tab.selected.bg.color=#6366f1
tab.selected.bg.color.alpha=30
tab.hover.bg.color=#6366f1
tab.hover.bg.color.alpha=15

[ScrollbarSpec]
scrollbar.bg.color=#f1f5f9
scrollbar.bg.color.alpha=120
scrollbar.slider.color=#6366f1
scrollbar.slider.color.alpha=60
scrollbar.slider.hover.color=#6366f1
scrollbar.slider.hover.color.alpha=110
