{
  "layer": "top",
  "position": "top",
  "height": 52,
  "margin-top": 0,
  "margin-bottom": 0,
  "margin-left": 10,
  "margin-right": 10,
  "spacing": 0,
  "modules-left": [
    "custom/arch",
    "hyprland/workspaces",
    "hyprland/window"
  ],
  "modules-center": [
    "clock"
  ],
  "modules-right": [
    "group/audio",
    "pulseaudio#microphone",
    "bluetooth",
    "network",
    "cpu",
    "temperature",
    "memory",
    "custom/clipboard",
    "custom/language",
    "battery",
    "custom/power",
    "group/tray",
  ],
  "custom/arch": {
    "exec": "~/.config/waybar/scripts/updates.sh",
    "format": "<span font='16'></span>",
    "return-type": "json",
    "interval": 600,
    "tooltip": true,
    "on-click": "pkill rofi || rofi -show drun",
    "on-click-right": "~/.config/waybar/scripts/power_menu.sh",
  },
  "hyprland/workspaces": {
    "sort-by-id": true,
    "all-outputs": true,
    "active-only": false,
    "format": "{name}",
    "persistent-workspaces": {
      "*": 5,
    },
  },
  "hyprland/window": {
    "format": " {title}",
    "max-length": 40,
    "separate-outputs": true,
  },
  "group/audio": {
    "orientation": "horizontal",
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
    "modules": [
      "pulseaudio",
      "pulseaudio/slider#audio"
    ],
  },
  "group/tray": {
    "orientation": "horizontal",
    "modules": [
      "custom/tray-toggler",
      "tray"
    ],
    "drawer": {
      "transition-duration": 500,
      "transition-left-to-right": false,
    },
  },
  "custom/tray-toggler": {
    "format": "",
    "tooltip": false,
  },
  "tray": {
    "icon-size": 18,
    "spacing": 10,
    "show-passive-items": true,
  },
  "clock": {
    "format": "{:L%H:%M  %a, %b %d}",
    "tooltip-format": "<big>{:%Y %B}</big>\n<tt><small>{calendar}</small></tt>",
    "on-click": "kitty --class medium-floating-term -e calcure",
  },
  "cpu": {
    "format": " {usage}%",
    "on-click": "kitty --class medium-floating-term -e btop",
    "tooltip": false,
  },
  "temperature": {
    "hwmon-path": "/sys/class/hwmon/hwmon4/temp1_input",
    "critical-threshold": 80,
    "format": "{icon}{temperatureC}°C",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
  },
  "memory": {
    "format": " {used:0.1f}GB",
  },
  "battery": {
    "states": {
      "warning": 30,
      "critical": 15,
    },
    "format": "{icon} {capacity}%",
    "format-charging": "󰂄 {capacity}%",
    "format-plugged": " {capacity}%",
    "format-alt": "{icon} {time}",
    "format-icons": [
      "",
      "",
      "",
      "",
      ""
    ],
  },
  "network": {
    "format-wifi": " ({signalStrength}%) 󰁞 {bandwidthUpBits} 󰁆 {bandwidthDownBits}",
    "format-ethernet": " {ipaddr} 󰁞 {bandwidthUpBits} 󰁆 {bandwidthDownBits}",
    "on-click": "kitty --class medium-floating-term -e impala",
    "format-linked": " (No IP)",
    "format-disconnected": "⚠ Disconnected",
    "tooltip-format": "{ifname} via {gwaddr} ",
    "interval": 2,
  },
  "pulseaudio": {
    "format": "<span font='14'>{icon}</span> {volume}%",
    "format-bluetooth": "<span font='14'>{icon} 󰂯</span> {volume}%",
    "format-bluetooth-muted": "<span font='14'>󰝟 {icon} 󰂯</span> {volume}%",
    "format-muted": "<span font='14'>󰝟</span> {volume}%",
    "format-icons": {
      "headphone": "󰋋",
      "hands-free": "󰋎",
      "headset": "󰋎",
      "phone": "",
      "portable": "",
      "car": "",
      "default": [
        "󰕿",
        "󰖀",
        "󰕾"
      ],
    },
    "on-click": "kitty --class floating-term -e wiremix",
  },
  "pulseaudio/slider#audio": {
    "min": 0,
    "max": 100,
    "orientation": "horizontal",
  },
  "pulseaudio#microphone": {
    "format": "{format_source}",
    "format-source": "<span font='14'>󰍬</span>",
    "format-source-muted": "<span font='14'>󰍭</span>",
    "on-click": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
    "on-scroll-up": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%+",
    "on-scroll-down": "wpctl set-volume @DEFAULT_AUDIO_SOURCE@ 5%-",
    "scroll-step": 5,
  },
  "bluetooth": {
    "format": "",
    "format-connected": " {num_connections}",
    "format-disconnected": "󰂲",
    "tooltip-format": "{controller_alias}\t{controller_address}",
    "tooltip-format-connected": "{controller_alias}\t{controller_address}\n\n{device_enumerate}",
    "tooltip-format-enumerate-connected": "{device_alias}\t{device_address}",
    "on-click": "kitty --class medium-floating-term -e bluetui",
  },
  "custom/language": {
    "exec": "~/.config/waybar/scripts/kb_layout.sh",
    "return-type": "json",
    "interval": 1,
    "on-click": "hyprctl switchxkblayout all next",
    "format": "{}",
  },
  "custom/clipboard": {
    "format": "{}",
    "exec": "~/.config/waybar/scripts/cliphist.sh --tooltip",
    "return-type": "json",
    "interval": 3,
    "signal": 9,
    "on-click": "~/.config/waybar/scripts/cliphist.sh --list",
    "on-click-middle": "~/.config/waybar/scripts/cliphist.sh --delete",
    "on-click-right": "~/.config/waybar/scripts/cliphist.sh --wipe",
    "tooltip": true,
    "tooltip-format": "Right Click to Clear",
  },
  "custom/power": {
    "format": "",
    "on-click": "~/.config/waybar/scripts/power_menu.sh",
    "tooltip": false,
  },
}