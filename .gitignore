# ==============================================================================
# .gitignore — Arch Post-Install & Dotfiles Suite
# ==============================================================================

# ── Logs & Crash Dumps ────────────────────────────────────────────────────────
logs/
*.log
*.crash
hyprlandCrashReport*.txt
/core
core.[0-9]*

# ── Dotfiles Runtime, State & Cache (Symlink Protection) ─────────────────────
# Note: modules/dotfiles.sh symlinks ~/.config/<app> to dotfiles/<app>.
# These rules ensure that runtime state, user data, and cache created by
# running desktop apps do not pollute git or leak sensitive history.

# Clipse (Clipboard Manager: history JSON, logs, cached images/payloads)
dotfiles/clipse/clipboard_history*.json
dotfiles/clipse/clipse.log
dotfiles/clipse/tmp_files/

# Calcure (Calendar & Task Manager: logs and automatic backups)
dotfiles/calcure/*.log
dotfiles/calcure/*.csv.bak

# Fish Shell (Runtime universal variables, history, and cache)
dotfiles/fish/fish_variables
dotfiles/fish/fish_variables.bak
dotfiles/fish/fish_history
dotfiles/fish/.cache/

# Hyprland & Keybinding Overrides (Generated by generate_user_bindings.sh)
dotfiles/hypr/bin/
dotfiles/hypr/config/keybinds/user_overrides.lua

# TUI Journal (Local SQLite databases, journals, and local entries)
dotfiles/tui-journal/*.db
dotfiles/tui-journal/*.db-journal
dotfiles/tui-journal/*.sqlite*
dotfiles/tui-journal/entries.json

# Superfile & Yazi (File manager runtime logs & state)
dotfiles/superfile/*.log
dotfiles/yazi/*.log

# Rofi Launcher Local State & Caches
dotfiles/rofi/recent_apps
dotfiles/rofi/apps_cache
dotfiles/rofi/history

# ── Backups & Overrides ───────────────────────────────────────────────────────
.config-backup-*/
config-backup-*/
*.bak
*.backup
*.old
*.orig
*.rej
*~

# Local configuration overrides (untracked user secrets/customs)
config/*.local.yaml
config/*.override.yaml
config/user.local.yaml
.env
.env.local
.env.*.local
!.env.example

# ── Editor & IDE Artifacts ───────────────────────────────────────────────────
# Vim / Neovim
*.swp
*.swo
*.swn
.*.swp
.*.swo
*.un~
.*.un~
[sS]ession.vim
*.shada
*.shada.tmp*

# Visual Studio Code & Cursor
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json
.cursor/
*.code-workspace

# JetBrains IDEs (CLion, PyCharm, IDEA, etc.)
.idea/
*.iml

# Sublime Text
*.sublime-project
*.sublime-workspace

# Emacs
\#*#
.#*

# ── OS & Filesystem Metadata ──────────────────────────────────────────────────
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
Thumbs.db:encryptable
ehthumbs.db
ehthumbs_vista.db
desktop.ini

# Linux
.fuse_hidden*
.directory
.Trash-*

# ── Temporary & Build Files ───────────────────────────────────────────────────
*.tmp
*.temp
*.set_etc_key.tmp
*.sock
build_test/

# Arch Linux packaging artifacts
*.pkg.tar.zst
*.pkg.tar.xz
*.pkg.tar.gz

# Language & Tooling Caches
__pycache__/
*.py[cod]
.pytest_cache/
.ruff_cache/
.mypy_cache/
node_modules/
.cache/
